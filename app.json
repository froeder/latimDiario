{
  "expo": {
    "name": "Latim Diário",
    "slug": "latimdiario",
    "version": "2.0.0",
    "description": "Sabedoria clássica, provérbios, brocardos e estudo diário da língua latina.",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "latimdiario",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F8F6F0",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.froeder.latimDiario"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#F8F6F0",
          "dark": {
            "image": "./assets/images/splash-icon.png",
            "backgroundColor": "#0E1014"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "3071c9c4-e71f-4992-9f12-87fc7866c43a"
      }
    }
  }
}
